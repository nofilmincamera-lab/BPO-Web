# ============================================================================
# BPO Intelligence Pipeline - Environment Configuration
# ============================================================================

# ============================================================================
# GPU DEPLOYMENT MODE
# ============================================================================
# Options: local-egpu, aws-gpu, gcp-gpu, azure-gpu, cpu-only
#
# local-egpu: Local external GPU via nvidia-docker (default)
# aws-gpu: AWS ECS/EC2 with GPU instances
# gcp-gpu: GCP Cloud Run/GKE with GPU nodes
# azure-gpu: Azure Container Instances/AKS with GPU
# cpu-only: CPU-only mode for development/testing
GPU_DEPLOYMENT_MODE=local-egpu

# GPU Configuration
# Set to "1" to force CPU-only mode (overrides GPU_DEPLOYMENT_MODE)
FORCE_CPU_ONLY=0

# NVIDIA Device Visibility (for local-egpu mode)
# Options: all, 0, 1, 2, etc. (specific GPU indices)
NVIDIA_VISIBLE_DEVICES=all

# GPU Memory Fraction (0.0-1.0)
# Limits GPU memory usage for shared GPU scenarios
GPU_MEMORY_FRACTION=0.9

# ============================================================================
# EMBEDDING MODEL CONFIGURATION
# ============================================================================
# Model selection for GPU-accelerated embeddings
# all-MiniLM-L6-v2: 384-dim, fastest, recommended (default)
# all-mpnet-base-v2: 768-dim, slower, higher quality
# paraphrase-multilingual-MiniLM-L12-v2: 384-dim, multilingual
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding batch size (adjust based on GPU memory)
# RTX 3060 (12GB): 32-64
# T4 (16GB): 64-128
# A10G (24GB): 128-256
EMBEDDING_BATCH_SIZE=32

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bpo_intel
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Connection pooling (via PgBouncer)
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25

# ============================================================================
# PREFECT ORCHESTRATION
# ============================================================================
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_WORK_QUEUE=default
PREFECT_WORK_POOL=default-pool

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# HEURISTICS CONFIGURATION
# ============================================================================
HEURISTICS_DIR=/heuristics
HEURISTICS_VERSION=2.0.0
DATA_DIR=/data

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Enable monitoring stack (set to "metrics" profile)
ENABLE_MONITORING=false

# ============================================================================
# OPTIONAL SERVICES
# ============================================================================
# LLM Fallback (Ollama)
ENABLE_LLM_FALLBACK=false
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434

# Quality Control (Label Studio)
ENABLE_QC=false
LABEL_STUDIO_HOST=http://localhost:8082
LABEL_STUDIO_USERNAME=admin@bpo-intel.local
LABEL_STUDIO_PASSWORD=admin123

# ============================================================================
# CLOUD-SPECIFIC CONFIGURATIONS
# ============================================================================

# AWS Configuration (for aws-gpu mode)
AWS_REGION=us-east-1
AWS_ECS_CLUSTER=bpo-pipeline
AWS_GPU_INSTANCE_TYPE=g4dn.xlarge  # T4 GPU, $0.526/hr
# Alternative: g5.xlarge (A10G, $1.006/hr), p3.2xlarge (V100, $3.06/hr)

# GCP Configuration (for gcp-gpu mode)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_GPU_TYPE=nvidia-tesla-t4  # T4 GPU
GCP_GPU_COUNT=1
# Alternative: nvidia-tesla-a100, nvidia-l4

# Azure Configuration (for azure-gpu mode)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=bpo-pipeline-rg
AZURE_LOCATION=eastus
AZURE_GPU_SKU=Standard_NC4as_T4_v3  # T4 GPU
# Alternative: Standard_NC6s_v3 (V100), Standard_ND96asr_v4 (A100)

# ============================================================================
# SUPABASE CONFIGURATION (Optional)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ============================================================================
# TIMEZONE
# ============================================================================
TZ=UTC

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
# spaCy batch size (CPU NER)
SPACY_BATCH_SIZE=100

# Database connection pool
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50

# Worker concurrency
PREFECT_WORKER_CONCURRENCY=4

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
